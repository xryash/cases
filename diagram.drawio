          </mxGeometry>
        </mxCell>
        <mxCell id="NHQG5dZ5LyIQvTeWw8Dn-262" connectable="0" parent="NHQG5dZ5LyIQvTeWw8Dn-261" style="edgeLabel;resizable=0;html=1;;align=center;verticalAlign=middle;" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;Replication between shards&lt;/font&gt;" vertex="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4ltZB655g5ph35LQoqA-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;RELIABILITY&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Database HA requires 3 datacenter zones, each holding full replicas&amp;nbsp;&lt;/div&gt;&lt;div&gt;of all shards. The 3-zone topology provides quorum-based protection&amp;nbsp;&lt;/div&gt;&lt;div&gt;against &#39;split-brain&#39; in coordinators, and a replication factor of 3&amp;nbsp;&lt;/div&gt;&lt;div&gt;guarantees zero data loss on single-node failure.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Schema and data changes to the primary database are applied through&amp;nbsp;&lt;/div&gt;&lt;div&gt;a single centralized repository as versioned migrations, deployed&amp;nbsp;&lt;/div&gt;&lt;div&gt;via GitLab CI/CD pipelines.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Stateless services run on Kubernetes — one cluster per datacenter.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Each service is independently deployed and scaled using Helm charts&amp;nbsp;&lt;/div&gt;&lt;div&gt;triggered by GitLab CI/CD.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="363.75" width="303.5" x="703.25" y="2570" as="geometry" />
        </mxCell>
        <mxCell id="a4ltZB655g5ph35LQoqA-2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="&lt;div&gt;&lt;b&gt;TOOLS&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;KAFKA CONNECT + KAFKA&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Used for data extraction, buffering, and delivery to the primary database&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;AIRFLOW&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Orchestrator for maintenance, data delivery, and data quality workflows&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;APACHE FLINK&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Streaming ETL engine for complex processing and near-real-time (NRT) delivery&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;DWH API + MCP&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Business-layer interface for data export and ClickHouse access - serving both&amp;nbsp;&lt;/div&gt;&lt;div&gt;human users and AI agents&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;PROMETHEUS + GRAFANA + TELEGRAM&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Metrics collection, visualization, and alerting stack&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="250" x="722" y="2171.25" as="geometry" />
        </mxCell>
        <mxCell id="a4ltZB655g5ph35LQoqA-3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="&lt;div&gt;&lt;b&gt;DATA FLOW&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;STG&lt;/b&gt; - raw ingested data, TTL ~1 week (retained for incident debugging&amp;nbsp;&lt;/div&gt;&lt;div&gt;and development purposes)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;INTERMEDIATE&lt;/b&gt; - long-term layer with cleansed, deduplicated data&amp;nbsp;&lt;/div&gt;&lt;div&gt;(cold partitions offloaded to S3)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;BUSINESS&lt;/b&gt; - curated, transformed datasets serving specific business&amp;nbsp;&lt;/div&gt;&lt;div&gt;use cases and downstream consumers&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Source -&amp;gt; STG -&amp;gt; INTERMEDIATE: ~5 min SLA (batched writes to avoid&amp;nbsp;&lt;/div&gt;&lt;div&gt;small-insert pressure on the database)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;BUSINESS layer ~1 hour SLA&lt;/div&gt;" vertex="1">
          <mxGeometry height="290" width="250" x="1030.75" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="a4ltZB655g5ph35LQoqA-4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;" value="&lt;div&gt;&lt;b&gt;COST OPTIMIZATION&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Open-source stack + in-house developments (DWH API, MCP layer), so no licensing fees, no vendor lock-in.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ClickHouse with properly designed table schemas achieves 10–20x&amp;nbsp;&lt;/div&gt;&lt;div&gt;compression ratios, significantly reducing storage footprint at&amp;nbsp;&lt;/div&gt;&lt;div&gt;20+ TB scale.&lt;/div&gt;" vertex="1">
          <mxGeometry height="363.75" width="303.5" x="1080" y="2570" as="geometry" />
        </mxCell>
        <mxCell id="a4ltZB655g5ph35LQoqA-6" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;sketch=1;curveFitting=1;jiggle=2;" target="NHQG5dZ5LyIQvTeWw8Dn-48" value="">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1640" y="1330" as="sourcePoint" />
            <mxPoint x="1840" y="1620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
