        <mxCell id="NHQG5dZ5LyIQvTeWw8Dn-236" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;sketch=1;curveFitting=1;jiggle=2;fillColor=#f8cecc;strokeColor=#b85450;" value="" vertex="1">
